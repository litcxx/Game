# The game's site (deploy/setup.sh installs it as /etc/caddy/Caddyfile with the
# domain in place of {$DOMAIN}): /ws — the game's WebSocket — goes to the server,
# which listens on 127.0.0.1 only; everything else is the client, as files of the
# current release. HTTPS is automatic: a Let's Encrypt certificate for a real
# domain, Caddy's own CA for localhost.
{$DOMAIN} {
	encode zstd gzip

	handle /ws {
		reverse_proxy 127.0.0.1:27998
	}

	handle {
		root * /opt/territory/current/client
		file_server
		# Vite names the assets by their content: cached for good. The page
		# itself is checked every time, so the next load after a deploy gets it.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@page not path /assets/*
		header @page Cache-Control "no-cache"
	}
}
