# =============================================================================
#  .clang-tidy для современного проекта на C++23
#
#  Рассчитан на clang-tidy 23, проверен также на 21 и 22: проверки, которых
#  в старой версии нет, просто пропускаются.
#  Проверить конфиг:  clang-tidy --verify-config
# =============================================================================
---
Checks:
  # ---------------------------------------------------------------------------
  # Базовые группы
  # ---------------------------------------------------------------------------
  - bugprone-*
  - clang-analyzer-*       # с clang-tidy 22 сам по себе не включается
  - concurrency-*
  - cppcoreguidelines-*
  - misc-*
  - modernize-*
  - performance-*
  - portability-*
  - readability-*
  # Точечно из google-*
  - google-default-arguments          # аргументы по умолчанию у виртуальных методов
  - google-global-names-in-headers    # using namespace в глобальной области заголовка

  # Только для clang-tidy <= 22 (в 23 эти проверки переехали в misc-* и bugprone-*):
  # - google-explicit-constructor
  # - hicpp-exception-baseclass

  # ---------------------------------------------------------------------------
  # Шумные, спорные или устаревшие для C++20+
  # ---------------------------------------------------------------------------
  - -bugprone-easily-swappable-parameters     # почти любая пара (int, int)
  - -bugprone-signed-bitwise                  # с C++20 сдвиги знаковых чисел определены
  - -cppcoreguidelines-avoid-do-while         # вкусовщина
  - -cppcoreguidelines-pro-bounds-constant-array-index              # требует gsl::at()
  - -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access  # каждый operator[]
  - -misc-multiple-inheritance                # правило Fuchsia, мешает миксинам
  - -misc-no-recursion
  - -modernize-macro-to-enum                  # советует enum, macro-usage — constexpr
  - -modernize-use-designated-initializers    # требует .x = в каждом Point{1, 2}
  - -modernize-use-nodiscard                  # [[nodiscard]] почти на каждом геттере
  - -modernize-use-string-view                # меняет API, фикс ломает вызывающий код
  - -modernize-use-trailing-return-type
  - -performance-enum-size                    # меняет ABI ради пары байт
  - -portability-avoid-pragma-once
  - -portability-simd-intrinsics              # std::simd появится только в C++26
  - -readability-identifier-length            # i, x, id — нормальные имена
  - -readability-magic-numbers
  - -readability-math-missing-parentheses
  - -readability-named-parameter
  - -readability-static-accessed-through-instance  # ложные срабатывания на корутинах
  - -readability-trailing-comma               # вопрос стиля
  - -readability-uppercase-literal-suffix
  - -clang-analyzer-optin.core.EnumCastOutOfRange  # ложные срабатывания на битовых флагах
  - -clang-analyzer-optin.performance.Padding
  - -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling  # memcpy -> memcpy_s

  # ---------------------------------------------------------------------------
  # Дубли: алиасы (=) и проверки, чью работу уже делает другая
  # ---------------------------------------------------------------------------
  - -bugprone-assignment-in-if-condition           # уже ловит bugprone-assignment-in-selection-statement
  - -bugprone-unhandled-code-paths                 # уже ловит bugprone-switch-missing-default-case
  - -clang-analyzer-security.FloatLoopCounter      # уже ловит bugprone-float-loop-counter
  - -cppcoreguidelines-avoid-c-arrays              # = modernize-avoid-c-arrays
  - -cppcoreguidelines-avoid-magic-numbers         # = readability-magic-numbers
  - -cppcoreguidelines-c-copy-assignment-signature # = misc-unconventional-assign-operator
  - -cppcoreguidelines-explicit-constructor        # = misc-explicit-constructor
  - -cppcoreguidelines-explicit-virtual-functions  # = modernize-use-override
  - -cppcoreguidelines-macro-to-enum               # = modernize-macro-to-enum
  - -cppcoreguidelines-narrowing-conversions       # = bugprone-narrowing-conversions
  - -cppcoreguidelines-noexcept-destructor         # = performance-noexcept-destructor
  - -cppcoreguidelines-noexcept-move-operations    # = performance-noexcept-move-constructor
  - -cppcoreguidelines-noexcept-swap               # = performance-noexcept-swap
  - -cppcoreguidelines-non-private-member-variables-in-classes  # = misc-...
  - -cppcoreguidelines-pro-type-cstyle-cast        # уже ловит modernize-avoid-c-style-cast
  - -cppcoreguidelines-use-default-member-init     # = modernize-use-default-member-init
  - -performance-faster-string-find                # = performance-prefer-single-char-overloads
  - -readability-inconsistent-ifelse-braces        # уже ловит readability-braces-around-statements
  - -readability-non-const-parameter               # уже ловит misc-const-correctness (23)

# Локально — предупреждения; в CI:  clang-tidy --warnings-as-errors='*'
WarningsAsErrors: ''

# Все заголовки проекта, кроме сторонних (-isystem пропускаются и так)
HeaderFilterRegex: '.*'
ExcludeHeaderFilterRegex: '(^|/)(_deps|third[_-]?party|external|vendor)/'
SystemHeaders: false

# Исправления (--fix) форматируются по .clang-format проекта
FormatStyle: file

CheckOptions:
  # --- C++23 -------------------------------------------------------------------
  # Лямбды-корутины с deducing this (this auto self) безопасны
  cppcoreguidelines-avoid-capturing-lambda-coroutines.AllowExplicitObjectParameters: true

  # --- Меньше шума -------------------------------------------------------------
  bugprone-unused-return-value.AllowCastToVoid: true
  cppcoreguidelines-special-member-functions.AllowSoleDefaultDtor: true
  cppcoreguidelines-special-member-functions.AllowMissingMoveFunctionsWhenCopyIsDeleted: true
  cppcoreguidelines-special-member-functions.AllowImplicitlyDeletedCopyOrMove: true
  misc-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic: true
  misc-use-internal-linkage.FixMode: None  # фикс ставит static, а misc-use-anonymous-namespace против
  readability-function-cognitive-complexity.IgnoreMacros: true
  readability-implicit-bool-conversion.AllowPointerConditions: true

  # --- Стиль имён проекта ------------------------------------------------------
  # Типы — CamelCase (MyClass)
  readability-identifier-naming.NamespaceCase: lower_case
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.UnionCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.TypeAliasCase: CamelCase
  readability-identifier-naming.TypedefCase: CamelCase
  readability-identifier-naming.ConceptCase: CamelCase
  readability-identifier-naming.TemplateParameterCase: CamelCase
  # Методы и свободные функции — snake_case (send_data)
  readability-identifier-naming.FunctionCase: lower_case
  readability-identifier-naming.MethodCase: lower_case
  # Переменные и параметры — snake_case
  readability-identifier-naming.VariableCase: lower_case
  readability-identifier-naming.LocalVariableCase: lower_case
  readability-identifier-naming.ParameterCase: lower_case
  readability-identifier-naming.StaticVariableCase: lower_case
  # Члены-данные: приватные/protected (классы) с суффиксом _ (data_),
  # публичные (структуры) — без суффикса (int8_t x)
  readability-identifier-naming.PrivateMemberCase: lower_case
  readability-identifier-naming.PrivateMemberSuffix: _
  readability-identifier-naming.ProtectedMemberCase: lower_case
  readability-identifier-naming.ProtectedMemberSuffix: _
  readability-identifier-naming.PublicMemberCase: lower_case
  # Константы времени компиляции — префикс k + CamelCase (kDataSize).
  # EnumConstant намеренно не ограничиваем: настоящие перечисления (Opcodes,
  # State, TileType) остаются CamelCase, а enum-константы вида kNumIterations
  # допустимы как есть.
  readability-identifier-naming.ConstexprVariableCase: CamelCase
  readability-identifier-naming.ConstexprVariablePrefix: k
  readability-identifier-naming.ClassConstantCase: CamelCase
  readability-identifier-naming.ClassConstantPrefix: k
  readability-identifier-naming.GlobalConstantCase: CamelCase
  readability-identifier-naming.GlobalConstantPrefix: k
  readability-identifier-naming.StaticConstantCase: CamelCase
  readability-identifier-naming.StaticConstantPrefix: k
  readability-identifier-naming.MacroDefinitionCase: UPPER_CASE
  # Имена, которых требует стандартная библиотека: контейнеры, итераторы, корутины
  readability-identifier-naming.TypeAliasIgnoredRegexp: '^([a-z_]+_type|(const_)?(reverse_)?iterator|(const_)?(reference|pointer)|iterator_(category|concept)|is_transparent)$'
  readability-identifier-naming.ClassIgnoredRegexp: '^promise_type$'
  readability-identifier-naming.StructIgnoredRegexp: '^promise_type$'
